# ---- Core ------------------------------------------------------------------
DEBUG=False
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=lab.example.in,localhost
CSRF_TRUSTED_ORIGINS=https://lab.example.in,https://localhost
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---- Database (PostgreSQL 16) ---------------------------------------------
POSTGRES_DB=aarogyam
POSTGRES_USER=aarogyam
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=postgres://aarogyam:change-me-too@db:5432/aarogyam

# ---- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Files --------------------------------------------------------------------
# Uploaded report PDFs live here (outside web root; served via X-Accel-Redirect)
PRIVATE_MEDIA_ROOT=/app/private_media
USE_X_ACCEL_REDIRECT=True

# ---- Business rules -------------------------------------------------------------
MAX_ACTIVE_EMPLOYEES=10
SESSION_IDLE_SECONDS=1800
AXES_COOLOFF_HOURS=1

# ---- First admin (used by `create_first_admin --noinput`) ---------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Email (optional, for daily reminder digests) -----------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@lab.example.in

# ---- Backups -------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2

# ---- Nginx / TLS (docker-compose.prod.yml, own public IP + Let's Encrypt) ---------
SERVER_NAME=localhost
LETSENCRYPT_EMAIL=

# ---- Site developer ----------------------------------------------------------------
# Full Admin + superuser, NOT counted against the 3-Admin cap. Comma-separated usernames.
DEVELOPER_ACCOUNTS=

# ---- Public link, option A: ngrok (same as TGMA) --------------------------------------
# Token: https://dashboard.ngrok.com/get-started/your-authtoken . When set, deploy.sh
# starts the ngrok container; `bash deploy.sh url` prints the address. Add
# .ngrok-free.app to ALLOWED_HOSTS and https://*.ngrok-free.app to CSRF_TRUSTED_ORIGINS.
# NGROK_URL = the account's free static domain (e.g. something.ngrok-free.app) for a
# link that does not change on restart. One online agent per free account.
NGROK_AUTHTOKEN=
NGROK_URL=

# ---- Public link, option B: Cloudflare Tunnel (docker-compose.server.yml) ----------
# Token of a Cloudflare tunnel whose public hostname points at  http://nginx:80
# (Zero Trust -> Networks -> Tunnels). Leave empty to run without a public link.
CLOUDFLARE_TUNNEL_TOKEN=
# nginx is also published on 127.0.0.1 only, for checks over SSH. To log in through
#   ssh -N -L 8090:127.0.0.1:8090 mmilab@<server>   ->   http://localhost:8090
# add http://localhost:8090 to CSRF_TRUSTED_ORIGINS, or the login form returns 403 CSRF
# (nginx reports every request as HTTPS, the browser's Origin is http://localhost:8090).
LAB_HTTP_PORT=8090
# Keep backups OUTSIDE the project directory.
BACKUP_DIR=/home/mmilab/aarogyam-backups
