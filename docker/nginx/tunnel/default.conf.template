# Server (PowerEdge) mode: plain HTTP behind Cloudflare Tunnel.
# Cloudflare terminates TLS; cloudflared on the host forwards to 127.0.0.1:${LAB_HTTP_PORT}.
# The port is published on loopback only, so nothing on the LAN can reach this directly.
upstream django { server web:8000; }

# Real client IP for the audit log. Tunnel agents (ngrok / cloudflared) run inside the
# compose network and append the visitor's IP to X-Forwarded-For; trust that header only
# from private (container) addresses, so $remote_addr becomes the visitor's IP.
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Cloudflare also sets CF-Connecting-IP authoritatively; prefer it when present.
map $http_cf_connecting_ip $client_ip {
    ""      $remote_addr;
    default $http_cf_connecting_ip;
}

server {
    listen 80 default_server;
    server_name _;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    # X-Robots-Tag is deliberately NOT set at server level. Until the public
    # site existed this blanketed everything with noindex, which was right then
    # and is wrong now: it would have made every public page unindexable while
    # the Django side said the opposite, with nothing in the app to show why.
    # NoIndexMiddleware (apps/core/middleware.py) sets it per request for the
    # staff half only - is_staff_area() is the single rule - and robots.txt
    # disallows those same prefixes.

    client_max_body_size 12m;
    server_tokens off;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    location /static/ {
        alias /app/staticfiles/;
        # Safe to cache hard: filenames carry a content hash (ManifestStaticFilesStorage),
        # so a changed file always arrives under a new name.
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Public uploads: centre and doctor photos only. Not content-hashed, so a
    # replaced photo needs a shorter life than /static/ - a week, revalidated.
    location /media/ {
        alias /app/public_media/;
        expires 7d;
        add_header Cache-Control "public, must-revalidate";
        # nginx drops the server-level add_headers inside any location that
        # sets one of its own, and this location serves files people uploaded -
        # so nosniff has to be repeated here, not assumed.
        add_header X-Content-Type-Options nosniff always;
    }

    # Uploaded prescriptions: only via Django's permission check + X-Accel-Redirect.
    location /_protected/ {
        internal;
        alias /app/private_media/;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location /protected/ { return 404; }
    location = /healthz { return 404; }   # container healthcheck only

    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        # Every real request arrived over HTTPS at Cloudflare.
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_redirect off;
    }
}
